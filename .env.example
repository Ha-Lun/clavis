# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# Appwrite Database & Storage
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
NEXT_PUBLIC_APPWRITE_BUCKET_ID=your-bucket-id

# NVIDIA NIM (get from https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-your-key-here

# Tavily Web Search (get from https://tavily.com/)
TAVILY_API_KEY=tvly-dev-your-key-here

# Google AI Studio / Gemini (get from https://aistudio.google.com/)
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-key
# Alternative: GEMINI_API_KEY=your-gemini-key